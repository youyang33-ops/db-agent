# 复制成 .env 再填写。不填 LLM_API_KEY 时，项目会自动使用离线的 MockLLM（规则模拟模型，只用来验证流程是否跑通）。

# ---- 大模型（任何 OpenAI 兼容接口都可以）----
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 通义千问（二选一，把上面三行注释掉）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=

# 强制使用离线模拟模型：LLM_PROVIDER=mock
# LLM_PROVIDER=mock

# ---- 阶段 4：远程 MCP Server ----
MCP_API_TOKEN=dev-token-change-me
MCP_HOST=127.0.0.1
MCP_PORT=8000
# 对外访问地址，必须和客户端连接的地址一致（鉴权时会校验 token 的 resource）
MCP_PUBLIC_URL=http://127.0.0.1:8000
